# NEXORA backend configuration -- EXAMPLE FILE
#
# Copy this to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. This example file is
# committed so that anyone cloning the repo knows which variables exist.
# Keep it in sync when you add a setting, but never put a real secret here.

# --- Application ---
APP_NAME=NEXORA
APP_ENV=development           # development | test | production
API_V1_PREFIX=/api/v1

# --- Security ---
# Minimum 32 characters. Generate a fresh one per environment with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value-at-least-32-chars

# --- Database ---
# Must match the credentials in docker-compose.yml for local development.
DATABASE_URL=postgresql+asyncpg://nexora:nexora_dev_password@localhost:5432/nexora
DB_ECHO=false                 # true logs every SQL statement (noisy; dev only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=3    # bounds the /health/ready probe

# --- Sessions / authentication ---
SESSION_COOKIE_NAME=nexora_session
SESSION_LIFETIME_DAYS=7
# SECURITY: false for local development only, because the browser refuses to
# store a Secure cookie sent over plain http://localhost. It MUST be true in
# production -- the app refuses to start otherwise.
SESSION_COOKIE_SECURE=false
# lax | strict | none. "lax" withholds the cookie on cross-site subrequests,
# which is the primary CSRF defence. "none" switches that off and therefore
# requires SESSION_COOKIE_SECURE=true; the app refuses to start otherwise,
# because browsers silently discard such a cookie.
SESSION_COOKIE_SAMESITE=lax

# --- Rate limiting (authentication endpoints) ---
# Per-IP: stops one machine guessing many passwords. Counts failed logins,
# and every signup attempt.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per-account: stops a botnet guessing one account's password from many
# addresses. Stricter, because a real person rarely mistypes five times in a
# minute. Cleared when that account signs in successfully.
AUTH_ACCOUNT_RATE_LIMIT_ATTEMPTS=5

# --- Chat rate limiting ---
# Keyed by user, not by IP. Every chat request costs money, so an unlimited
# endpoint is a financial denial of service.
CHAT_RATE_LIMIT_ATTEMPTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- AI ---
# Which model adapter the gateway builds: anthropic | gemini | echo
#
# "echo" is a fake, offline provider that streams canned text. It is the
# default so the app starts with no credentials, and it is what tests and
# frontend work use so neither costs money. The app REFUSES to start with
# echo when APP_ENV=production.
#
# Set AI_PROVIDER=gemini for real development against Google's API, and leave
# it as echo for offline test runs.
AI_PROVIDER=echo

# Required when AI_PROVIDER=anthropic; the app refuses to start without it.
# SECURITY: this is a real credential. It is never sent to the browser -- all
# model calls are made server-side. Never commit it; .env is git-ignored.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required when AI_PROVIDER=gemini; the app refuses to start without it.
# Same security rules as above: server-side only, never committed.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model id, shared by every provider -- so it must MATCH the provider.
#   AI_PROVIDER=anthropic  ->  AI_MODEL=claude-opus-5
#   AI_PROVIDER=gemini     ->  AI_MODEL=gemini-3-flash-preview  (verified 2026-10-27)
#
# Switching the provider and forgetting this sends a Claude model id to Google
# (or vice versa) and gets back a confusing 404 from a provider that has never
# heard of it. Settings refuses to start on an obvious mismatch.
AI_MODEL=claude-opus-5
# Caps the length of any single reply, which caps the cost of a single
# request. An unbounded value lets one user spend a lot of money.
AI_MAX_TOKENS=4096
# Dev-only: pause between chunks from the echo provider so streaming can be
# watched arriving piece by piece. Leave at 0 for tests.
AI_ECHO_CHUNK_DELAY_SECONDS=0
# Seconds a reply may go without producing anything before it is abandoned
# with "assistant unavailable". Generous, because "thinking" models reason
# before their first token. (One preview model once took 524s to answer.)
AI_STREAM_IDLE_TIMEOUT_SECONDS=90

# --- File uploads ---
# Where uploaded bytes are written. Kept outside the source tree so an upload
# can never be picked up as application code, and so this can be a mounted
# volume in production. Created at runtime; git-ignored.
UPLOAD_DIR=var/uploads
# SECURITY/COST: the hard ceiling on one upload, enforced while streaming
# rather than by trusting the Content-Length a client sends.
MAX_UPLOAD_BYTES=20971520     # 20MB
# DOCX and XLSX are ZIP archives, so a small upload can decompress to
# something enormous. Extraction stops at this many characters, which bounds
# memory and the eventual prompt.
MAX_EXTRACTED_CHARACTERS=1000000
# Bounds how long parsing one PDF can take; a hostile file with a huge page
# count is otherwise a CPU denial of service.
MAX_PDF_PAGES=500
UPLOAD_RATE_LIMIT_ATTEMPTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# --- Image reading ---
# "none" stores images without reading them. "gemini" has a multimodal model
# transcribe and describe each image on upload, so it can be searched and
# asked about. Needs GEMINI_API_KEY. COST: one paid call per image uploaded.
IMAGE_READER=none
# Verified working on 2026-10-27; the gemini-2.5 models were listed for the
# key but returned 404 when called.
IMAGE_READER_MODEL=gemini-3-flash-preview
IMAGE_READER_TIMEOUT_SECONDS=60

# --- Retrieval (RAG) ---
# Which embedding adapter the gateway builds. Separate from AI_PROVIDER,
# because embeddings and chat generation are bought separately -- Anthropic
# sells no embedding model.
#
# "hashing" is an offline LEXICAL stand-in: it matches on shared vocabulary,
# not on meaning. It will not connect "I forgot my login" to a passage about
# resetting a password. It exists so the pipeline can be built and tested for
# free. Refused when APP_ENV=production.
#
# "gemini" is semantic and needs GEMINI_API_KEY. Google bills it per input
# token: every chunk of every upload is embedded once, every chat question
# once, and a re-index embeds everything again.
#
# Changing provider or model does NOT corrupt anything: each chunk records the
# model that embedded it, and search only compares against chunks from the
# active model. Old chunks become unsearchable until you re-embed them:
#   python -m scripts.reindex --dry-run   # how many files need it
#   python -m scripts.reindex             # do it (resumable, safe to rerun)
EMBEDDING_PROVIDER=hashing
# Model id. Blank uses the provider default (gemini: gemini-embedding-001).
# The vector width is fixed by the database column (512), not by this.
EMBEDDING_MODEL=
# Upper bound on one embedding request, in seconds. If the query embedding
# times out, the chat still answers -- just without document context.
EMBEDDING_TIMEOUT_SECONDS=20

# Target passage size, in characters. Small chunks retrieve precisely but
# arrive without context; large ones carry context but dilute the match and
# cost more tokens per hit.
CHUNK_SIZE_CHARACTERS=1200
# How much of the previous chunk each one repeats, so a fact split across a
# boundary is not lost to both halves.
CHUNK_OVERLAP_CHARACTERS=200
# How many passages a search returns. Each is sent to the model, so this is a
# cost and context-window decision, not only a quality one.
RETRIEVAL_TOP_K=5
# Cosine similarity below this counts as "no match". Without a floor, search
# always returns its k nearest chunks however irrelevant.
# 0.15 was tuned for "hashing". Semantic models score unrelated text much
# higher: with gemini-embedding-001 (512 dims), correct matches measured
# 0.67-0.71 and unrelated questions at most 0.58, so use 0.62 there.
RETRIEVAL_MIN_SIMILARITY=0.15
# Passages taken from files added to the chat itself. These skip the floor
# above -- the person put the file in this chat -- so this cap bounds their
# cost in the prompt.
CONVERSATION_FILE_TOP_K=6

# --- CORS ---
# Comma-separated allow-list of browser origins. Never use "*".
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console (dev) | json (production)
